# Backend only. Never expose these variables in a Vite bundle.
# Validated at startup by packages/backend/src/config.js — a missing or
# malformed required variable stops the server before it listens.
NODE_ENV=development
PORT=3111
LISTEN_HOST=127.0.0.1
DB_PATH=./demo/data/recruitment.sqlite
RECRUITMENT_STORAGE_DIR=./demo/storage/recruitment
# Optional outside production: a deterministic demo key is generated if empty.
# In production this must be 32 random bytes, e.g. `openssl rand -base64 32`.
RECRUITMENT_FILE_KEY=
RECRUITMENT_RETENTION_DAYS=180
RECRUITMENT_MAX_FILE_MB=10

# OpenAI Responses API. The snapshot is pinned for reproducible evaluations.
# Optional outside production; the demo server uses its own deterministic
# analyzer instead and never calls OpenAI when this is empty.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano-2026-03-17
OPENAI_TIMEOUT_MS=45000

# Public anti-abuse control. Leave empty only in local development/test:
# bypassing Turnstile is never allowed when NODE_ENV=production.
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=

# SMTP is configured by these variables in production. Optional outside
# production; the demo server uses a jsonTransport that sends nothing.
SMTP_HOST=mail.spacemail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@techzone.lat
SMTP_PASS=
SMTP_FROM=TECH ZONE Recrutement <contact@techzone.lat>

# Production only: absolute path to the private TechZone host adapter module.
# It must export db, sessionMiddleware, requireAdminOrigin and requireAdminSession;
# never commit it here.
RECRUITMENT_HOST_ADAPTER=

# Contact for access, correction, opposition, and deletion requests.
# Always required, in every mode.
PRIVACY_CONTACT_EMAIL=contact@techzone.lat
