# Paths on the host, used only by Docker Compose. Host code stays read-only;
# the SQLite directory is mounted read-write for its database and WAL files.
# Copy to deployment/compose.env (mode 0600) and replace paths for the host.
TECHZONE_HOST_BACKEND_ROOT=/var/www/techzone-app/current/backend
TECHZONE_HOST_SHARED_ROOT=/var/www/techzone-app/current/shared
TECHZONE_HOST_DB_DIRECTORY=/var/www/techzone-app/current/backend/db
RECRUITMENT_HOST_ADAPTER_SOURCE=/var/www/techzone-recruitment/private/recruitment-host-adapter.cjs
# Keep synchronized with deployment/nginx-recruitment.conf. The deployment
# preflight confirms this loopback port is free before deployment.
RECRUITMENT_HOST_PORT=3011
# Dedicated loopback port for docker-compose.recruitment-test.yml.
RECRUITMENT_TEST_HOST_PORT=3012
