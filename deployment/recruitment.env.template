# Server-only values. Store the real file outside Git with mode 0600.
# Validated at startup by packages/backend/src/config.js: a missing or
# malformed required variable stops the server before it listens.
# The adapter process must use the same values as the TechZone host service.
NODE_ENV=production
PORT=3111
TRUST_PROXY_HOPS=1
# Path as seen inside the recruitment process, pointing at the host's SQLite DB.
DB_PATH=/opt/techzone/host-backend/db/techzone.sqlite
SESSION_SECRET=replace_with_the_existing_host_session_secret
SESSION_COOKIE_NAME=techzone_admin_session
CORS_ORIGIN=https://www.techzone.lat
ADMIN_ORIGIN=https://www.techzone.lat
OPENAI_API_KEY=replace_me
OPENAI_MODEL=gpt-5.4-nano-2026-03-17
OPENAI_TIMEOUT_MS=45000
RECRUITMENT_FILE_KEY=replace_with_openssl_rand_base64_32
RECRUITMENT_STORAGE_DIR=/var/lib/techzone/recruitment
RECRUITMENT_RETENTION_DAYS=180
RECRUITMENT_MAX_FILE_MB=10
TURNSTILE_SECRET_KEY=replace_me
VITE_TURNSTILE_SITE_KEY=replace_me
SMTP_HOST=replace_me
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace_me
SMTP_PASS=replace_me
SMTP_FROM=TECH ZONE Recrutement <contact@techzone.lat>
PRIVACY_CONTACT_EMAIL=contact@techzone.lat
RECRUITMENT_HOST_ADAPTER=/opt/techzone/private/recruitment-host-adapter.cjs
TECHZONE_HOST_BACKEND_ROOT=/opt/techzone/host-backend

# Do not add these flags to the primary environment. They are reserved for
# deployment/recruitment.test.env on recrutement.techzone.lat.
# RECRUITMENT_TEST_DEPLOYMENT=true
# RECRUITMENT_TEST_PORTAL=true
