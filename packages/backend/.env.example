# Copier en .env à la racine du dépôt (jamais commité). Variables lues par packages/backend/src/config.js.
NODE_ENV=development
PORT=3111
DB_PATH=./demo/data/recruitment.sqlite
RECRUITMENT_STORAGE_DIR=./demo/storage/recruitment
RECRUITMENT_FILE_KEY=            # production : openssl rand -base64 32
PRIVACY_CONTACT_EMAIL=contact@techzone.lat

# Adresse publique du site : utilisée dans les liens des e-mails (réinitialisation, suivi de candidature).
# OBLIGATOIRE en production, ex. https://recrutement.techzone.lat
PUBLIC_BASE_URL=http://127.0.0.1:5173

# E-mails : dès que SMTP_HOST, SMTP_USER et SMTP_PASS sont renseignés, la démo ET la production
# envoient de vrais e-mails avec ce compte. Sinon ils sont simulés dans la console.
# Port 465 -> SMTP_SECURE=true ; port 587 -> SMTP_SECURE=false.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=TECH ZONE Recrutement <contact@techzone.lat>
# MAIL_MODE=simulation   # force la simulation même si le SMTP est configuré

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano-2026-03-17
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=
